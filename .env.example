# LifePilot Mobile - Environment Configuration
# Copy this file to .env.local for local overrides.
# NOTE: Only variables prefixed with EXPO_PUBLIC_ are exposed to the client bundle.

# Environment: development | staging | production
EXPO_PUBLIC_ENV=development

# Base URL for the future Laravel REST API
# Android Emulator host loopback address is typically http://10.0.2.2:8000/api/v1
# Physical device on local network: http://<LAN_IP>:8000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# API Request Timeout (in milliseconds)
EXPO_PUBLIC_API_TIMEOUT=15000

# SQLite Local Database Configuration
EXPO_PUBLIC_DB_NAME=lifepilot.db

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_OFFLINE_SYNC=true
